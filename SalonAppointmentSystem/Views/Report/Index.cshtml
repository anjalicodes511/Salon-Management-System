
@{
    ViewBag.Title = "Reports";
}

@Html.Partial("_Navbar")
<div class="text-center mb-5">
    <h1 class="hero-title mt-2">
        Report Section
    </h1>
    <div class="mx-auto mt-2"
         style="width:60px;height:4px;border-radius:2px;
                background:linear-gradient(135deg,#6f42c1,#0d6efd);">
    </div>
</div>


@Html.ActionLink("← Back", "Index", "Account", null, new { @class = "btn btn-hover background-primary mb-4" })
<div class="row g-4 mb-5">


    <!-- Appointment Overview Card -->
    <div class="col-md-12 mb-4">
        <div class="card report-card shadow-sm">
            <div class="card-header background-primary text-white d-flex justify-content-between align-items-center">
                <h5 class="mb-0">📅 Appointment Overview</h5>
                <button class="btn btn-sm btn-light toggle-btn">Details</button>
            </div>

            <div class="card-body">

                <!-- KPI Section -->
                <div class="row text-center mb-3">
                    <div class="col">
                        <h4 id="totalAppointments">0</h4>
                        <small>Total</small>
                    </div>
                    <div class="col">
                        <h4 id="bookedAppointments">0</h4>
                        <small>Pending</small>
                    </div>
                    <div class="col">
                        <h4 id="cancelledAppointments">0</h4>
                        <small>Cancelled</small>
                    </div>
                    <div class="col">
                        <h4 id="absentAppointments">0</h4>
                        <small>No show</small>
                    </div>
                    <div class="col">
                        <h4 id="completedAppointments">0</h4>
                        <small>Completed</small>
                    </div>
                </div>

                <!-- Hidden Detail Table -->
                <div class="details-section d-none">
                    <div style="max-height:200px; overflow-y:auto;">
                        <table class="table table-sm text-center report-table">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>Customer</th>
                                    <th>Service</th>
                                    <th>Status</th>
                                    <th>Stylist</th>
                                </tr>
                            </thead>
                            <tbody id="appointmentTableBody">
                            </tbody>
                        </table>
                    </div>
                </div>

            </div>
        </div>
    </div>


    <!-- Revenue Card -->
    <div class="col-md-12 mb-4">
        <div class="card report-card shadow-sm">
            <div class="card-header bg-emerald text-white d-flex justify-content-between align-items-center">
                <h5 class="mb-0">💰 Revenue Report</h5>
                <button class="btn btn-sm btn-light toggle-btn">Details</button>
            </div>

            <div class="card-body">

                <!-- Big Revenue -->
                <div class="text-center mb-3">
                    <h3>₹ <span id="totalRevenue">0</span></h3>
                    <small>Total Revenue</small>
                </div>

                <!-- Hidden Table -->
                <div class="details-section d-none">
                    <div style="max-height:200px; overflow-y:auto;">
                        <table class="table table-sm text-center report-table">
                            <thead>
                                <tr>
                                    <th>Service</th>
                                    <th>Bookings</th>
                                    <th>Revenue</th>
                                </tr>
                            </thead>
                            <tbody id="revenueTableBody">
                            </tbody>
                        </table>
                    </div>
                </div>

            </div>
        </div>
    </div>


    <div class="col-md-12 mb-4">
        <div class="card report-card shadow-sm">
            <div class="card-header bg-deepblue text-white d-flex justify-content-between align-items-center">
                <h5 class="mb-0">📈 Monthly Revenue Trend</h5>
                <button class="btn btn-sm btn-light toggle-btn">Details</button>
            </div>
            <div class="card-body details-section d-none">
                <canvas id="revenueChart" height="100"></canvas>
            </div>
        </div>
    </div>


    <div class="col-md-12 mb-4">
        <div class="card report-card shadow-sm">
            <div class="card-header bg-warm text-white d-flex justify-content-between align-items-center">
                <h5 class="mb-0">💇 Popular Services</h5>
                <button class="btn btn-sm btn-light toggle-btn">Details</button>
            </div>
            <div class="card-body details-section d-none">
                <table class="table report-table text-center mb-0">
                    <thead>
                        <tr>
                            <th>Service</th>
                            <th>Bookings</th>
                        </tr>
                    </thead>
                    <tbody id="serviceTableBody"></tbody>
                </table>
            </div>
        </div>
    </div>
</div>



<style>

    .report-table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0 8px; 
        font-size: 14px;
    }


        .report-table thead th {
            background: transparent;
            font-weight: 600;
            text-transform: uppercase;
            font-size: 12px;
            letter-spacing: 0.5px;
            color: #6c757d;
            border: none;
            padding: 8px 12px;
        }

        .report-table tbody tr {
            background: #ffffff;
            box-shadow: 0 2px 8px rgba(0,0,0,0.04);
            border-radius: 10px;
            transition: all 0.2s ease;
        }

            .report-table tbody tr:hover {
                transform: translateY(-2px);
                box-shadow: 0 6px 16px rgba(0,0,0,0.08);
            }

        .report-table tbody td {
            padding: 12px;
            border: none;
            vertical-align: middle;
        }

        /* Rounded row effect */
        .report-table tbody tr td:first-child {
            border-top-left-radius: 10px;
            border-bottom-left-radius: 10px;
            font-weight: 500;
        }

        .report-table tbody tr td:last-child {
            border-top-right-radius: 10px;
            border-bottom-right-radius: 10px;
        }

        /* Sticky modern header */
        .report-table thead {
            position: sticky;
            top: 0;
            z-index: 2;
            background: #f8f9fc;
        }
    .status-badge {
        padding: 5px 12px;
        border-radius: 50px;
        font-size: 12px;
        font-weight: 600;
        display: inline-block;
    }

        .status-badge.booked {
            background: rgba(13,110,253,0.1);
            color: #0d6efd;
        }

        .status-badge.completed {
            background: rgba(25,135,84,0.12);
            color: #198754;
        }

        .status-badge.cancelled {
            background: rgba(220,53,69,0.12);
            color: #dc3545;
        }

        .status-badge.absent {
            background: rgba(255,193,7,0.15);
            color: #856404;
        }
    .details-section {
        border-top: 1px solid #eee;
        padding-top: 15px;
        background: #f9fafc;
        border-radius: 12px;
    }
        .details-section::-webkit-scrollbar {
            width: 6px;
        }

        .details-section::-webkit-scrollbar-thumb {
            background: linear-gradient(45deg,#6a11cb,#2575fc);
            border-radius: 10px;
        }

</style>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

@section Scripts{
    <script>
        $(document).ready(function () {
            loadAppointmentReport();
            loadRevenueReport();
            loadMonthlyRevenue();
            loadPopularServices();

        });

        $(document).on("click", ".toggle-btn", function () {
            var details = $(this).closest(".card").find(".details-section");
            details.toggleClass("d-none");
        });

        function loadPopularServices() {
            $.get("/Report/GetPopularServicesReport", function (res) {

                var rows = "";
                res.forEach(function (item) {
                    rows += `<tr>
                            <td>${item.ServiceName}</td>
                            <td>${item.TotalBookings}</td>
                         </tr>`;
                });

                $("#serviceTableBody").html(rows);
            });
        }


        function loadAppointmentReport() {
            $.ajax({
                url: "/Report/GetAppointmentsReport",
                type: "GET",
                success: function (res) {
                    $("#totalAppointments").text(res.total);
                    $("#bookedAppointments").text(res.booked);
                    $("#cancelledAppointments").text(res.cancelled);
                    $("#completedAppointments").text(res.completed);
                    $("#absentAppointments").text(res.absent);

                    var rows = "";
                    var recentAppointments = res.recentAppointments;
                    recentAppointments.forEach((item) => {
                        rows += `<tr>
                                    <td>${item.date}</td>
                                    <td>${item.customer}</td>
                                    <td>${item.service}</td>
                                    <td>
                                       <span class="status-badge ${item.status.toLowerCase()}">
                                           ${item.status}
                                       </span>
                                    </td>
                                    <td>${item.stylist}</td>
                                 </tr>`;
                    });

                    $("#appointmentTableBody").html(rows);
                },
                error: function () {
                    alert('Something Went Wrong');
                }
            });
        }

        function loadRevenueReport() {

            $.ajax({
                url: "/Report/GetRevenueReport",
                type: "GET",
                success: function (res) {

                    $("#totalRevenue").text(res.totalRevenue);

                    var rows = "";
                    var serviceRevenue = res.serviceRevenue;
                    serviceRevenue.forEach((item) => {
                        rows += `<tr>
                                            <td>${item.service}</td>
                                            <td>${item.bookings}</td>
                                            <td>₹ ${item.revenue}</td>
                                        </tr>`;
                    });

                    $("#revenueTableBody").html(rows);
                },
                error: function () {
                    alert('Something Went Wrong');
                }
            });
        }

        function loadMonthlyRevenue() {
            $.ajax({
                url: "/Report/GetMonthlyRevenueReport",
                type: "GET",
                success: function (res) {

                    var ctx = document.getElementById('revenueChart').getContext('2d');

                    new Chart(ctx, {
                        type: 'line',
                        data: {
                            labels: res.months,
                            datasets: [{
                                label: 'Revenue',
                                data: res.revenue,
                                borderWidth: 2,
                                tension: 0.3
                            }]
                        },
                        options: {
                            responsive: true,
                            plugins: {
                                legend: { display: false }
                            }
                        }
                    });
                }
            });
        }

    </script>
}