@{
    ViewBag.Title = "Home";
    var username = Session["Username"] as string;
}

@Html.Partial("_Navbar")

<div class="container mt-5">

    <!-- Welcome Section -->
    <div class="welcome-card mb-5">
        <div class="welcome-content">
            <h1 class="welcome-title color-primary">
                Welcome back, <span class="username">@username</span> ✨
            </h1>

            <p class="welcome-subtitle">
                @(Session["Role"]?.ToString() == "Customer"
                ? "Your beauty journey starts here. Manage appointments effortlessly."
                : "Manage your salon operations with ease")
            </p>
        </div>
    </div>




    <!-- Dashboard Panels -->
    <div class="dashboard-panels">

        @if (Session["Role"]?.ToString() == "Customer")
        {
            <a href="@Url.Action("Index", "Service")" class="dashboard-panel">
                <div class="panel-content">
                    <h5>Book Appointment</h5>
                    <h2>Manage Now</h2>
                    <p>Schedule a service with your preferred stylist.</p>
                </div>
                <div class="panel-icon">📅</div>
            </a>

            <a href="@Url.Action("Index", "Service")" class="dashboard-panel">
                <div class="panel-content">
                    <h5>Our Services</h5>
                    <h2>Explore</h2>
                    <p>Browse salon services and pricing.</p>
                </div>
                <div class="panel-icon">💇</div>
            </a>

            <a href="@Url.Action("Appointments", "Appointment")" class="dashboard-panel">
                <div class="panel-content">
                    <h5>My Appointments</h5>
                    <h2>View All</h2>
                    <p>Manage your upcoming bookings.</p>
                </div>
                <div class="panel-icon">🧾</div>
            </a>

            <a href="@Url.Action("MyDetails", "Home")" class="dashboard-panel">
                <div class="panel-content">
                    <h5>Profile</h5>
                    <h2>My Account</h2>
                    <p>View and update your details.</p>
                </div>
                <div class="panel-icon">👤</div>
            </a>
        }
        else if (Session["Role"]?.ToString() == "Admin")
        {
            <a href="@Url.Action("AllAppointments", "Appointment")" class="dashboard-panel">
                <div class="panel-content">
                    <h5>Appointments</h5>
                    <h2>Manage</h2>
                    <p>Approve or cancel bookings.</p>
                </div>
                <div class="panel-icon">📅</div>
            </a>

            <a href="@Url.Action("Index", "Service")" class="dashboard-panel">
                <div class="panel-content">
                    <h5>Services</h5>
                    <h2>Manage</h2>
                    <p>Add or update salon services.</p>
                </div>
                <div class="panel-icon">💇</div>
            </a>

            <a href="@Url.Action("Index", "Stylist")" class="dashboard-panel">
                <div class="panel-content">
                    <h5>Stylists</h5>
                    <h2>Manage</h2>
                    <p>Update stylist information.</p>
                </div>
                <div class="panel-icon">✂️</div>
            </a>

            <a href="@Url.Action("CustomerDetails", "Admin")" class="dashboard-panel">
                <div class="panel-content">
                    <h5>Customers</h5>
                    <h2>View</h2>
                    <p>See registered customers.</p>
                </div>
                <div class="panel-icon">👥</div>
            </a>

            <a href="@Url.Action("Index", "Report")" class="dashboard-panel">
                <div class="panel-content">
                    <h5>Reports</h5>
                    <h2>Generate</h2>
                    <p>Appointments & revenue reports.</p>
                </div>
                <div class="panel-icon">📊</div>
            </a>

            <a href="@Url.Action("Signup", "Account")" class="dashboard-panel">
                <div class="panel-content">
                    <h5>Admin Access</h5>
                    <h2>Add New</h2>
                    <p>Create new admin accounts.</p>
                </div>
                <div class="panel-icon">🔐</div>
            </a>
        }

    </div>

    <div class="text-center mt-5">
        @Html.ActionLink("🏠 Back to Home", "Index", "Home", null, new { @class = "btn btn-hover mb-4" })
    </div>

</div>

<style>
    .welcome-card {
        position: relative;
        padding: 55px 60px;
        border-radius: 24px;
        overflow: hidden;
        background: linear-gradient(135deg, #eef2ff, #e0f2fe);
        box-shadow: 0 20px 60px rgba(124, 58, 237, 0.08);
    }

        /* Softer floating shapes */
        .welcome-card::before,
        .welcome-card::after {
            content: "";
            position: absolute;
            border-radius: 50%;
        }

        .welcome-card::before {
            width: 260px;
            height: 260px;
            background: rgba(124, 58, 237, 0.08);
            top: -100px;
            right: -80px;
        }

        .welcome-card::after {
            width: 180px;
            height: 180px;
            background: rgba(59, 130, 246, 0.08);
            bottom: -80px;
            right: 40px;
        }

    .welcome-title {
        font-size: 2.6rem;
        font-weight: 700;
        background: linear-gradient(90deg, #3b044e, #9c64d0, #8b090c);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        letter-spacing: -0.5px;
        margin: 0;
    }


    .welcome-subtitle {
        margin-top: 14px;
        font-size: 1.05rem;
        color: #6b7280;
    }


    /* Dashboard Grid */
    .dashboard-panels {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 25px;
    }

    /* Card Style Like Image */
    .dashboard-panel {
        position: relative;
        padding: 30px;
        border-radius: 16px;
        color: #fff;
        text-decoration: none;
        overflow: hidden;
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        transition: transform 0.3s ease;
        box-shadow: 0 10px 30px rgba(0,0,0,0.15);
    }

        .dashboard-panel:hover {
            transform: translateY(-6px);
        }

        /* Remove old accent line */
        .dashboard-panel::before {
            display: none;
        }

        /* Soft Circle Shapes */
        .dashboard-panel::after {
            content: "";
            position: absolute;
            width: 160px;
            height: 160px;
            background: rgba(255,255,255,0.15);
            border-radius: 50%;
            top: -40px;
            right: -40px;
        }

        .dashboard-panel span {
            content: "";
            position: absolute;
            width: 120px;
            height: 120px;
            background: rgba(255,255,255,0.1);
            border-radius: 50%;
            bottom: -30px;
            right: 30px;
        }

    /* Text Styling */
    .panel-content h5 {
        margin: 0;
        font-size: 0.95rem;
        font-weight: 500;
        opacity: 0.9;
    }

    .panel-content h2 {
        margin: 5px 0;
        font-size: 1.8rem;
        font-weight: 700;
    }

    .panel-content p {
        margin: 0;
        font-size: 0.85rem;
        opacity: 0.85;
    }

    /* Icon Top Right */
    .panel-icon {
        font-size: 1.8rem;
        opacity: 0.9;
    }

    /* Gradient Colors (like image style) */
    .dashboard-panel:nth-child(1) {
        background: linear-gradient(135deg, #f6a37a, #e57373);
    }

    .dashboard-panel:nth-child(2) {
        background: linear-gradient(135deg, #64b5f6, #42a5f5);
    }

    .dashboard-panel:nth-child(3) {
        background: linear-gradient(135deg, #4db6ac, #26a69a);
    }

    .dashboard-panel:nth-child(4) {
        background: linear-gradient(135deg, #ffb74d, #fb8c00);
    }

    .dashboard-panel:nth-child(5) {
        background: linear-gradient(135deg, #9575cd, #7e57c2);
    }

    .dashboard-panel:nth-child(6) {
        background: linear-gradient(135deg, #81c784, #66bb6a);
    }

</style>